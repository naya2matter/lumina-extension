{
  "manifest_version": 3,
  "name": "PNE LC AI",
  "version": "1.0.0",
  "description": "Connect your Gemini account to PNE LC AI.",
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": ["cookies", "activeTab", "clipboardWrite", "tabs", "scripting"],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://ai.lcportal.cloud/*",
    "https://backend.ai.lcportal.cloud/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://ai.lcportal.cloud/*"
      ],
      "js": ["content.js"],
      "all_frames": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://backend.ai.lcportal.cloud;"
  }
}
